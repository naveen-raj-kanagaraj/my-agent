# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=        # your Telegram user ID (comma-separated for several)
OWNER_TELEGRAM_ID=           # enables the hourly digest

# Web search (serper.dev)
SERPER_API_KEY=

# Discord (optional)
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

# News digest (optional)
DIGEST_TO=telegram            # telegram, discord or both
DIGEST_TIMES=08:00,19:00      # local times for the daily briefs
BREAKING_EVERY_MIN=60         # 0 turns breaking-news checks off

# WhatsApp via Twilio (optional, off unless ENABLE_WHATSAPP=true)
ENABLE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
MY_WHATSAPP_NUMBER=
