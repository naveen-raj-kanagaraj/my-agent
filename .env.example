# Nothing here is required. The dashboard link is sent through your main agent's bot automatically
# (read from ~/my-agent/.env). Install cloudflared for the public link: brew install cloudflared
PUBLIC_DASHBOARD=true
# Optional: a separate Telegram bot just for tracker commands (leave empty for dashboard only)
TRACKER_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Optional: free YouTube Data API key for exact counts (Google Cloud > APIs > YouTube Data API v3 > Credentials)
YOUTUBE_API_KEY=
FAST_SEC=10          # count every live stream this often
DISCOVER_SEC=60      # search for new streams this often
DASHBOARD_PORT=8091
EVENT_TZ=Asia/Kolkata
