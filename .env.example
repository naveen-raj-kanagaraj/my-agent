# Telegram bot just for the tracker (create one with @BotFather: /newbot). Not your main agent's token.
TRACKER_BOT_TOKEN=
# Your Telegram user id (same as OWNER_TELEGRAM_ID in your main agent's .env)
OWNER_TELEGRAM_ID=
# Optional: free YouTube Data API key for exact counts (Google Cloud > APIs > YouTube Data API v3 > Credentials)
YOUTUBE_API_KEY=
FAST_SEC=10          # count every live stream this often
DISCOVER_SEC=60      # search for new streams this often
DASHBOARD_PORT=8091
EVENT_TZ=Asia/Kolkata
