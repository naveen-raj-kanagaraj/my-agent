# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=           # your Telegram user ID: no limits, full briefings, owner commands
OWNER_TIMEZONE=America/Chicago
DAILY_LIMIT=20               # requests per day for everyone else
PUBLIC_DAILY_BUDGET_USD=0.50 # all other users together; they pause for the day when reached
OWNER_DAILY_BUDGET_USD=3.00  # safety net for your own usage; 0 disables

# Optional: more models for the picker (each appears once its key is set)
OPENAI_API_KEY=              # platform.openai.com > API keys (separate billing)
# Model IDs/prices can be overridden per model, e.g. GPT_SOL_MODEL_ID=..., GEMINI_PRO_PRICE=2,12
# (see core/models.py for the full list: Haiku, Sonnet, Opus, Fable, GPT Luna/Terra/Sol, Gemini Flash-Lite/Flash/Pro)
GEMINI_API_KEY=              # aistudio.google.com > Get API key

PICKER_SESSION_HOURS=2        # keep using the chosen model until this long without messages

# Dashboard (http://localhost:8090 on the computer running the agent)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8090
DASHBOARD_TOKEN=             # set this before exposing it beyond this computer

# Web search (serper.dev)
SERPER_API_KEY=

# Discord (optional)
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

# Owner briefing
DIGEST_TO=telegram            # telegram, discord or both
DIGEST_TIMES=08:00,19:00      # local times for the daily briefs
BREAKING_EVERY_MIN=60         # 0 turns breaking-news checks off

# Personalised news for every user (their local time)
NEWS_TIMES=08:00,19:00

# News sources (Google News, Reddit and Hacker News are free; X/IG/Threads and YouTube use 1 Serper credit each per topic)
NEWS_WINDOW_HOURS=24         # only items newer than this
NEWS_CACHE_MINUTES=30        # reuse a search for this long before checking again
NEWS_SOCIAL=true
NEWS_YOUTUBE=true
NEWS_FEEDS=                  # extra RSS feeds, comma-separated
REDDIT_CLIENT_ID=            # optional: more reliable Reddit (reddit.com/prefs/apps, 'script' app)
REDDIT_CLIENT_SECRET=

# Content radar for the owner
RADAR_TIME=10:00             # empty disables
RADAR_TOPICS=                # comma-separated; empty = creator economy, talent, entertainment, brands, gaming, media funding
RADAR_SUBREDDITS=NewTubers,CreatorsAdvice,socialmedia,marketing,IndianGaming,bollywood,StartUpIndia
RADAR_COMPETITORS=           # comma-separated channel names to watch

# Keyword alerts (free: news sites, Reddit, Hacker News)
ALERT_EVERY_MIN=30
ALERT_MAX_AGE_HOURS=6
MAX_WATCHES_PUBLIC=3

# Talent tracker weekly summary (Mondays, your local time)
PIPELINE_WEEKLY_TIME=09:00

# Extras
PUBLIC_IMAGE_GEN=false       # let non-owners generate images
WHISPER_MODEL=base           # small = better for Tamil/Hindi mixes, bigger download

# WhatsApp via Twilio (optional, off unless ENABLE_WHATSAPP=true)
ENABLE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
MY_WHATSAPP_NUMBER=
